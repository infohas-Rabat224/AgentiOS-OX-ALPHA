{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/v2/tooling/cli/schema.json",
  "productName": "AgenticOS",
  "version": "1.0.0-rc10",
  "identifier": "com.agenticos.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AgenticOS — Desktop Mission Control (v1.0.0-rc10)",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "allowlist": {
    "all": false,
    "shell": {
      "all": false,
      "execute": true,
      "open": true
    },
    "http": {
      "all": true,
      "request": true,
      "scope": [
        "http://127.0.0.1:8001/*",
        "http://localhost:8001/*",
        "http://127.0.0.1:3000/*",
        "http://localhost:3000/*"
      ]
    },
    "process": {
      "all": true,
      "relaunch": true,
      "exit": true
    },
    "fs": {
      "all": true,
      "scope": ["$APPDATA/**", "$LOCALAPPDATA/**", "$RESOURCE/**"]
    },
    "path": {
      "all": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../python/": "python/",
      "../AgenticosHybrid/": "AgenticosHybrid/",
      "../build-windows/bin/agenticos-kernel.exe": "bin/agenticos-kernel.exe",
      "../build-windows/bin/AgenticOS.exe": "bin/AgenticOS.exe",
      "../start-agenticos.bat": "start-agenticos.bat"
    },
    "windows": {
      "nsis": {
        "installerName": "AgenticOS-Setup-x64.exe",
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "sidebarImage": null,
        "installMode": "currentUser",
        "startMenuFolder": "AgenticOS",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "template": "../build-windows/installer.nsi"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
